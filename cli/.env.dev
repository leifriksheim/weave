# The dev node: a throwaway local identity for `npm run dev` and `npm run p2p`.
# Not a secret worth keeping — it guards test data in .p2p-dev/ on this machine
# only. A real node takes its passphrase from somewhere private
# (see cli/p2p-node.service).
P2P_HOME=.p2p-dev
P2P_PASSPHRASE=dev-only-not-a-secret
PORT=8787
