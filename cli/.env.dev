# The dev node: a throwaway local identity for `npm run dev` and `npm run weave`.
# Not a secret worth keeping — it guards test data in .weave-dev/ on this machine
# only. A real node takes its passphrase from somewhere private
# (see cli/weave-node.service).
WEAVE_HOME=.weave-dev
WEAVE_PASSPHRASE=dev-only-not-a-secret
PORT=8787
