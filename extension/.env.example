# Copy to .env.local (not committed) and change what you need. Read by
# `npm run build` and `npm run dev`; a variable set in the shell wins.

# The account home the welcome tab offers first. People can type their own.
WEAVE_HOME=http://localhost:5174
# WEAVE_HOME=https://weave-home.netlify.app

# Relays, comma separated. The home's own relays arrive when you connect and are
# used too. Drop the localhost one if you never run `npm run signal`.
WEAVE_RELAYS=ws://localhost:8787,wss://p2p-web-relay.fly.dev
