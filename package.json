{
  "name": "weave",
  "private": true,
  "type": "module",
  "description": "Weave: the protocol, its CLI and relay, and the apps built on it",
  "workspaces": [
    "packages/core",
    "packages/relay",
    "packages/cli",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "weave": "node --env-file=packages/cli/.env.dev --conditions=@weaveprotocol/source --import tsx packages/cli/src/main.ts",
    "signal": "node packages/relay/signaling-server.mjs",
    "build": "npm run build -w @weaveprotocol/core && npm run bundle -w @weaveprotocol/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
