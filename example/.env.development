# Defaults for `npm run dev`. Override any of these in example/.env.local (not committed).

# Where peers meet. `npm run dev` at the repo root starts an always-on node on
# this port, and it is a relay too.
VITE_SIGNALING_URL=ws://localhost:8787

# Always-on nodes to keep a socket to. Remove it to test browsers alone.
VITE_P2P_NODES=ws://localhost:8787/peer
