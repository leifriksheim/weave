# Defaults for `npm run dev`. Override any of these in liquid/.env.local (not committed).

# Where peers meet: the node `npm run dev` starts (a relay too), and the public one.
VITE_SIGNALING_URL=ws://localhost:8787,wss://p2p-web-relay.fly.dev

# Always-on nodes to keep a socket to. Remove it to test browsers alone.
VITE_WEAVE_NODES=ws://localhost:8788/peer,ws://localhost:8787/peer

# The account home this app connects to: `npm run dev` starts one on 5174.
VITE_WEAVE_HOME=http://localhost:5174/connect

# The host "Keep online" suggests, and where a new device looks for its account: `npm run dev` starts one on 8788.
VITE_WEAVE_HOST=http://localhost:8788

# What "Add a bot" tells an admin to run, before the flags: the CLI from this repo.
VITE_WEAVE_CONNECT=npm run weave -- connect
