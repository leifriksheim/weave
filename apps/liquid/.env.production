# Defaults for production builds. Override in the host's environment settings.

# The public relay, on Fly.io. Comma-separate to add more.
VITE_SIGNALING_URL=wss://p2p-web-relay.fly.dev

# The account home this app connects to. Anyone can deploy their own (apps/home).
VITE_WEAVE_HOME=https://weave-home.netlify.app/connect
