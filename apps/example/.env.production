# Defaults for production builds (Netlify and anything else running `vite build`).
# Override in the host's environment settings, or in example/.env.production.local.

# The public relay, on Fly.io (server/). Comma-separate to add more: peers meet
# through whichever relays they share.
VITE_SIGNALING_URL=wss://p2p-web-relay.fly.dev

# The account home this app connects to. Anyone can deploy their own (home/).
VITE_WEAVE_HOME=https://weave-home.netlify.app/connect

# The host this build offers under "Keep my spaces online", and restores accounts from
# (packages/cli/fly.toml). Set it once the host is deployed:
# VITE_WEAVE_HOST=https://weave-host.fly.dev
