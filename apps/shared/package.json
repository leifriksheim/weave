    "./Modal": "./src/Modal.tsx",
    "./Wordmark": "./src/Wordmark.tsx",
    "./useDismiss": "./src/useDismiss.ts",
    "./hash": "./src/hash.ts",
    "./mini-app": "./src/mini-app.ts",
    "./Payment": "./src/Payment.tsx",
    "./CommunitySetup": "./src/CommunitySetup.tsx",
    "./Feature": "./src/Feature.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
