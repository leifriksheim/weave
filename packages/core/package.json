{
  "name": "@weaveprotocol/core",
  "version": "0.4.0",
  "type": "module",
  "description": "Self-sovereign P2P protocol for the browser — identity, schemas, storage, networking, and gossip sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leifriksheim/weave.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@weaveprotocol/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "@weaveprotocol/source": "./src/storage/index.ts",
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./node-worker": {
      "@weaveprotocol/source": "./src/node-worker.ts",
      "types": "./dist/node-worker.d.ts",
      "import": "./dist/node-worker.js"
    },
    "./node": {
      "@weaveprotocol/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./schemas": {
      "@weaveprotocol/source": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./session": {
      "@weaveprotocol/source": "./src/session/index.ts",
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./elements": {
      "@weaveprotocol/source": "./src/elements/index.ts",
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./react": {
      "@weaveprotocol/source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./calls": {
      "@weaveprotocol/source": "./src/calls/index.ts",
      "types": "./dist/calls/index.d.ts",
      "import": "./dist/calls/index.js"
    },
    "./doors": {
      "@weaveprotocol/source": "./src/doors/index.ts",
      "types": "./dist/doors/index.d.ts",
      "import": "./dist/doors/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tests",
    "test": "node --experimental-vm-modules --import tsx --test --test-concurrency=4 --test-timeout=60000 --test-force-exit tests/*.test.ts",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm -f README.md",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@noble/curves": "^2.4.0",
    "@scure/base": "^2.4.0",
    "aws4fetch": "^1.0.20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
